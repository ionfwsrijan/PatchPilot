# Backend settings. The app reads real environment variables: export these, or
# pass this file with `docker run --env-file backend/.env.example ...`.

# How many hours a job may sit idle before the hourly cleanup removes its
# workspace folder and its rows (jobs, findings, verify_outcomes, fixes).
#   - Default is 24. Cleanup is ON by default, and the first pass runs about a
#     minute after startup, so jobs older than this are removed on upgrade.
#   - 0 turns cleanup off.
#   - Decimals are fine (0.5 = 30 minutes).
#   - nan, inf, negative numbers and text fall back to 24 with a warning.
#   - "Idle" counts from the later of the job's creation and its last use
#     (scan, Fix, Verify, evidence pack).
#   - Running scans and jobs in use are skipped, but that is tracked in the
#     memory of a single API process. Running several workers? Use a large
#     value or 0.
JOB_TTL_HOURS=24
